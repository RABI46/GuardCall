<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Aucune permission dangereuse n'est demandée : le filtrage d'appels passe
      exclusivement par le rôle système ROLE_CALL_SCREENING, accordé par
      l'utilisateur via RoleManager. Une version précédente demandait
      READ_PHONE_STATE, READ_CALL_LOG, CALL_PHONE, ANSWER_PHONE_CALLS et
      READ_CONTACTS sans en utiliser aucune — surface d'attaque inutile et motif
      de rejet à la revue Play Store.
    -->

    <application
        android:name=".GuardCallApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuardCall"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GuardCall">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service de filtrage d'appels (Android 7.0+ / API 24). -->
        <service
            android:name=".screening.GuardCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>
