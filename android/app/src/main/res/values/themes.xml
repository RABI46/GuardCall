<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Thème de la fenêtre, appliqué avant le premier rendu Compose (splash).
      Reprend le tricolore : barre d'état bleue, accent rouge.
      `statusBarColor` (API 21) et `windowLightStatusBar` (API 23) restent
      compatibles avec minSdk 26 — contrôle `NewApi` de lint.
    -->
    <style name="Theme.Onraccroche" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:colorAccent">@color/secondary</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>
